{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "internal",
  "description": "Kite's own pages shown in tabs (kite://settings, kite://bookmarks): local pages only, never remote ones",
  "webviews": ["tab-*"],
  "local": true,
  "permissions": [
    "allow-settings-get",
    "allow-settings-set",
    "allow-mcp-renew-token",
    "allow-copy-text",
    "allow-clear-data",
    "allow-bookmarks-all",
    "allow-bookmark-save",
    "allow-bookmark-delete",
    "allow-bookmarks-import"
  ]
}
