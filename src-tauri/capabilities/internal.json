{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "internal",
  "description": "Kite's own pages shown in tabs (kite://settings, kite://bookmarks): local pages only, never remote ones",
  "webviews": [
    "tab-*"
  ],
  "local": true,
  "permissions": [
    "allow-settings-get",
    "allow-settings-set",
    "allow-mcp-renew-token",
    "allow-copy-text",
    "allow-clear-data",
    "allow-bookmarks-all",
    "allow-bookmark-save",
    "allow-bookmark-delete",
    "allow-bookmarks-import",
    "allow-bookmark-folder-move",
    "allow-bookmark-folder-order",
    "allow-bookmark-folder-order-set",
    "allow-bookmark-folders",
    "allow-bookmark-folder-create",
    "allow-bookmark-folder-rename",
    "allow-bookmark-folder-delete",
    "allow-extensions-list",
    "allow-extension-install",
    "allow-extension-install-folder",
    "allow-extension-remove",
    "allow-extension-open",
    "allow-passwords-list",
    "allow-password-reveal",
    "allow-password-delete",
    "allow-password-never-remove",
    "allow-theme-get",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-meet-host",
    "allow-meet-join",
    "allow-meet-send",
    "allow-meet-admit",
    "allow-meet-leave",
    "allow-neterror-retry",
    "allow-neterror-search",
    "allow-portal-get",
    "allow-portal-set",
    "allow-portal-seed",
    "allow-portal-icon",
    "allow-portal-export",
    "allow-portal-import",
    "allow-neterror-proceed",
    "allow-downloads-list",
    "allow-download-action",
    "allow-downloads-clear",
    "allow-downloads-open-dir",
    "allow-downloads-pick-dir",
    "allow-favicons"
  ]
}
