{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "content",
  "description": "Web pages in tabs: only the shortcut/url-change notification",
  "webviews": [
    "tab-*"
  ],
  "remote": {
    "urls": [
      "https://*",
      "http://*",
      "https://*/*",
      "http://*/*"
    ]
  },
  "permissions": [
    "allow-content-event"
  ]
}
